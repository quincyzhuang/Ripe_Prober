{
  "name": "ripe-prober",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that watches RIPE Atlas probe status and pushes alerts via ntfy",
  "scripts": {
    "test": "node --test",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "kv:create": "wrangler kv namespace create STATE",
    "secret:token": "wrangler secret put NTFY_TOPIC",
    "secret:admin": "wrangler secret put ADMIN_TOKEN",
    "check:local": "node scripts/local-check.js"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
